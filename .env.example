# Copy this file to .env and fill it in. Never commit .env.

# Prior Labs API key, with the TabPFN-3.5 licence accepted in your account (used to download the weights)
TABPFN_TOKEN=

# Hugging Face read token, with access granted to the gated dataset SAP/SALT
HF_TOKEN=

# Optional: the chat agent. Without an LLM the "Explain an order" tab still works, with template wording.
ANTHROPIC_API_KEY=

# Optional: choose the LLM (a LangChain model string). Default when ANTHROPIC_API_KEY is set: anthropic:claude-opus-5-5
# PRECEDENT_LLM=anthropic:claude-opus-5-5

# Optional: use a different guardrails file than src/precedent/guardrails.toml
# PRECEDENT_GUARDRAILS=

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=precedent
